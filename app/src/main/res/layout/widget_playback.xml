<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/widget_playback_background">
    <TextView android:id="@+id/playback_album_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/app_name" android:textColor="#E8EAF0" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@+id/control_search" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_search" android:background="@drawable/widget_control_background" android:contentDescription="Choose wallpaper" />
        <ImageButton android:id="@+id/control_previous_album" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_album_previous" android:background="@drawable/widget_control_background" android:contentDescription="Previous album" />
        <ImageButton android:id="@+id/control_previous_image" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_image_previous" android:background="@drawable/widget_control_background" android:contentDescription="Previous image" />
        <ImageButton android:id="@+id/control_pause" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_pause" android:background="@drawable/widget_control_background" android:contentDescription="Pause" />
        <ImageButton android:id="@+id/control_next_image" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_image_next" android:background="@drawable/widget_control_background" android:contentDescription="Next image" />
        <ImageButton android:id="@+id/control_next_album" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_album_next" android:background="@drawable/widget_control_background" android:contentDescription="Next album" />
        <ImageButton android:id="@+id/control_random_image" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_image_random" android:background="@drawable/widget_control_background" android:contentDescription="Random image" />
        <ImageButton android:id="@+id/control_random_album" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="6dp" android:src="@drawable/ic_control_album_random" android:background="@drawable/widget_control_background" android:contentDescription="Random album" />
    </LinearLayout>
</LinearLayout>
